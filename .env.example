# Скопіюйте у .env і змініть усі паролі.

# Вхід у веб-інтерфейс (один обліковий запис)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Випадковий рядок для підпису сесій (наприклад: python -c "import secrets;print(secrets.token_hex(32))")
SECRET_KEY=change-me-long-random-string

# База даних
DB_PASSWORD=change-me-db

# MQTT: обліковий запис сервера на брокері
MQTT_ADMIN_USER=server
MQTT_ADMIN_PASSWORD=change-me-mqtt
# Токен реєстрації модулів, той самий вшивається в прошивку (PROVISION_TOKEN)
PROVISION_TOKEN=change-me-provision
# TLS для модулів: false на домашньому ПК, true на VPS (тоді покладіть fullchain.pem і privkey.pem у MQTT_CERTS_DIR)
MQTT_TLS=false
MQTT_PUBLIC_PORT=1883
# MQTT_CERTS_DIR=/etc/letsencrypt/live/example.com

# Адреса, за якою модулі бачать сервер (для завантаження прошивки по OTA)
PUBLIC_URL=http://192.168.1.10:8080

# Веб: ":80" для домашнього ПК; на VPS доменне ім'я (наприклад monitor.example.com) вмикає HTTPS автоматично.
# На VPS також поставте HTTP_PORT=80 і HTTPS_PORT=443.
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443
