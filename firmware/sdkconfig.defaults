# Спільні налаштування для ESP32-S3 і ESP32-C3
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_4mb.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_4mb.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# OTA: дозволяємо http:// для локальної розробки; автоматичного відкату немає (план)
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y
# CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE is not set

# TLS: вбудований набір кореневих сертифікатів
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Консоль і налаштування з сайту через нативний USB (USB Serial/JTAG)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Живлення: детектор просадки перезапускає плату вже на ~2,9 В (типово ~2,5 В, коли
# flash може працювати ненадійно і плата зависає). На ESP32-S3 рівень 4 = 2,84 В, на C3 = 2,92 В.
CONFIG_ESP_BROWNOUT_DET=y
CONFIG_ESP_BROWNOUT_DET_LVL_SEL_4=y
# Сторож задач перезапускає плату з самого старту (далі addons.c задає 8 с)
CONFIG_ESP_TASK_WDT_PANIC=y
