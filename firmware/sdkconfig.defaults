# Спільні налаштування для ESP32-S3 і ESP32-C3
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_4mb.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_4mb.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# OTA: дозволяємо http:// для локальної розробки; автоматичного відкату немає (план)
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y
# CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE is not set

# TLS: вбудований набір кореневих сертифікатів
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
